generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  FRONT_DESK
  HOUSEKEEPING
  MAINTENANCE
  CUSTOMER
}

enum RoomStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  CLEANING
  MAINTENANCE
  OUT_OF_SERVICE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CARD
  GCASH
  EWALLET
  BANK_TRANSFER
  CASH
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PricingRuleType {
  WEEKEND
  OCCUPANCY
  SEASON
  HOLIDAY
  HISTORICAL_DEMAND
  ROOM_TYPE
  LEAD_TIME
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  firstName    String
  lastName     String
  role         UserRole
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  customerProfile     CustomerProfile?
  createdReservations Reservation[]       @relation("CreatedBy")
  housekeepingTasks   HousekeepingTask[]  @relation("HousekeepingAssignee")
  maintenanceTickets  MaintenanceTicket[] @relation("MaintenanceAssignee")

  @@index([role, isActive])
}

model CustomerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@index([phone])
}

model RoomType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String   @unique
  description String?
  capacity    Int
  beds        String?
  baseRate    Decimal  @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms        Room[]
  reservations Reservation[]
  pricingRules PricingRule[]

  @@index([isActive])
}

model Room {
  id         String     @id @default(cuid())
  roomNumber String     @unique
  roomTypeId String
  floor      Int?
  status     RoomStatus @default(AVAILABLE)
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  roomType           RoomType            @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  reservations       Reservation[]       @relation("AssignedRoom")
  housekeepingTasks  HousekeepingTask[]
  maintenanceTickets MaintenanceTicket[]

  @@index([roomTypeId, status])
  @@index([status])
  @@index([floor])
}

model Reservation {
  id              String  @id @default(cuid())
  reference       String  @unique
  customerId      String?
  createdByUserId String?
  roomTypeId      String
  assignedRoomId  String?

  guestFirstName  String
  guestLastName   String
  guestEmail      String
  guestPhone      String?
  guestCount      Int
  specialRequests String?

  checkInDate  DateTime          @db.Date
  checkOutDate DateTime          @db.Date
  status       ReservationStatus @default(PENDING)

  nightlyRate    Decimal @db.Decimal(12, 2)
  subtotal       Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)

  promotionId String?
  discountId  String?

  checkedInAt        DateTime?
  checkedOutAt       DateTime?
  cancelledAt        DateTime?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer     CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy    User?            @relation("CreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  roomType     RoomType         @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  assignedRoom Room?            @relation("AssignedRoom", fields: [assignedRoomId], references: [id], onDelete: SetNull)
  promotion    Promotion?       @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  discount     Discount?        @relation(fields: [discountId], references: [id], onDelete: SetNull)
  payments     Payment[]

  @@index([customerId, createdAt])
  @@index([guestEmail])
  @@index([checkInDate, checkOutDate, status])
  @@index([roomTypeId, status])
  @@index([assignedRoomId, status])
  @@index([promotionId])
  @@index([discountId])
}

model Payment {
  id            String        @id @default(cuid())
  reference     String        @unique
  reservationId String
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  provider      String?
  providerRef   String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, status])
  @@index([status, createdAt])
}

model Discount {
  id              String        @id @default(cuid())
  code            String        @unique
  name            String
  description     String?
  type            PromotionType
  value           Decimal       @db.Decimal(12, 2)
  minimumAmount   Decimal?      @db.Decimal(12, 2)
  startDate       DateTime?     @db.Date
  endDate         DateTime?     @db.Date
  isActive        Boolean       @default(true)
  customerVisible Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  reservations Reservation[]

  @@index([isActive, startDate, endDate])
  @@index([customerVisible, isActive])
}

model PricingRule {
  id         String          @id @default(cuid())
  name       String
  type       PricingRuleType
  roomTypeId String?
  priority   Int             @default(100)
  isActive   Boolean         @default(true)

  startDate    DateTime? @db.Date
  endDate      DateTime? @db.Date
  dayOfWeek    Int?
  minOccupancy Decimal?  @db.Decimal(5, 2)
  maxOccupancy Decimal?  @db.Decimal(5, 2)
  minLeadDays  Int?
  maxLeadDays  Int?
  demandLevel  String?

  fixedRate     Decimal? @db.Decimal(12, 2)
  adjustmentPct Decimal? @db.Decimal(7, 2)
  adjustmentAmt Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roomType RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([type, isActive, priority])
  @@index([roomTypeId, isActive])
  @@index([startDate, endDate])
}

model Promotion {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  description String?
  type        PromotionType
  value       Decimal       @db.Decimal(12, 2)
  minSpend    Decimal?      @db.Decimal(12, 2)
  maxDiscount Decimal?      @db.Decimal(12, 2)
  startDate   DateTime      @db.Date
  endDate     DateTime      @db.Date
  usageLimit  Int?
  usageCount  Int           @default(0)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  reservations Reservation[]

  @@index([isActive, startDate, endDate])
}

model HousekeepingTask {
  id           String       @id @default(cuid())
  roomId       String
  assignedToId String?
  status       TaskStatus   @default(PENDING)
  priority     TaskPriority @default(NORMAL)
  notes        String?
  scheduledAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  room       Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("HousekeepingAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([roomId, status])
  @@index([assignedToId, status])
}

model MaintenanceTicket {
  id           String       @id @default(cuid())
  roomId       String
  assignedToId String?
  title        String
  description  String?
  status       TaskStatus   @default(PENDING)
  priority     TaskPriority @default(NORMAL)
  openedAt     DateTime     @default(now())
  startedAt    DateTime?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  room       Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("MaintenanceAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([roomId, status])
  @@index([assignedToId, status])
  @@index([priority, status])
}

model HotelSettings {
  id String @id @default("default")

  hotelName String @default("ELARA Hotel")
  location  String @default("Tagaytay, Philippines")

  contactEmail String?
  contactPhone String?

  checkInTime  String @default("14:00")
  checkOutTime String @default("12:00")

  currency String @default("PHP")

  cancellationPolicy String?
  reservationNotes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
